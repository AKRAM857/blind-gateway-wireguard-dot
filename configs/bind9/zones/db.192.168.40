$TTL 604800
@   IN  SOA dns1.firstzone.akram.com. admin.akram.com. (
            1          ; serial
            604800     ; refresh
            86400      ; retry
            2419200    ; expire
            604800 )   ; negative cache ttl

@   IN  NS   ns1.firstzone.akram.com.
50   IN  PTR  mgmt.firstzone.akram.com.
40   IN  PTR  web.firstzone.akram.com.
